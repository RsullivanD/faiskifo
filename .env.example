# Example environment variables for faiskifo Supabase integration

# Public (ANON) key and URL — safe to expose to the client
NEXT_PUBLIC_SUPABASE_URL=https://xyzproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pk.XXXXXXXXXXXXXXXXXXXXXXXX

# NEVER commit secrets. The service_role key must NEVER be stored in the frontend or committed.
# Example (do NOT put the real service_role here):
# SUPABASE_SERVICE_ROLE_KEY=service_role.XXXXXXXXXXXXXXXXXXXXXXXX
